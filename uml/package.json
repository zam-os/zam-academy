{
  "name": "zam-academy-uml",
  "version": "0.1.0",
  "private": true,
  "description": "ZAM Academy: an interactive UML 2.5.1 editor and learning path (6 stages, 24 lessons, DE/EN), served at https://academy.zam-os.org/uml/.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:zip": "npm run build && node scripts/build-release-zip.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
