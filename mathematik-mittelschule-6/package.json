{
  "name": "zam-academy-mathematik-mittelschule-6",
  "version": "0.1.0",
  "private": true,
  "description": "Bavarian Grade 6 Mittelschule mathematics: seven learning areas, interactive labs and two practice levels.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:zip": "npm run build && node scripts/build-release-zip.mjs",
    "check:curriculum": "node scripts/check-curriculum.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
