{
  "name": "zam-academy-mathematik-realschule-8",
  "version": "0.1.0",
  "private": true,
  "description": "ZAM Academy: Mathematik 8 Realschule Bayern, getrennte Lernpfade für Zweig I und II/III, interaktive Labore und Aufgaben.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:zip": "npm run build && node scripts/build-release-zip.mjs",
    "cell:generate": "node scripts/generate-cell.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
