{
	"name": "zam-academy-mathematik-grundschule-4",
	"version": "0.1.0",
	"private": true,
	"description": "Discovery Island: German place-value practice for Grade 4 in Bavaria.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc --noEmit",
