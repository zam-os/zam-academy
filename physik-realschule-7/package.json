{
  "name": "zam-academy-physik-realschule-7",
  "version": "0.1.0",
  "private": true,
  "description": "Grade 7 physics for Bavarian Realschule Group I: mechanics, optics, magnetism and circuits.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests && node --test scripts/cell-contract.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:zip": "npm run build && node scripts/build-release-zip.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
