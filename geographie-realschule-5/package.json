{
	"name": "zam-academy-geographie-realschule-5",
	"version": "0.1.0",
	"private": true,
	"description": "ZAM Academy: Grade 5 Realschule geography, Bavaria; offline maps, workshops and local research.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"package:zip": "npm run build && node scripts/build-release-zip.mjs",
		"verify:content": "node scripts/verify-content.mjs",
		"verify:release": "node scripts/verify-release.mjs",
		"verify:browser": "node scripts/browser-smoke.mjs"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vite-plugin-singlefile": "^2.3.3",
		"vitest": "^4.1.10"
	},
	"license": "Apache-2.0"
}
