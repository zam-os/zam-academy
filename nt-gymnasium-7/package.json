{
  "name": "zam-academy-nt-gymnasium-7",
  "version": "0.0.0",
  "private": true,
  "description": "Grade 7 Natur und Technik at a Bavarian Gymnasium, with Physics and Informatics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode academy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:zip": "npm run build && node scripts/build-release-zip.mjs",
    "predev": "node scripts/build-physics.mjs",
    "prebuild": "node scripts/build-physics.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0"
}
